# Skill-Link Environment Configuration Template
# Copy this file to .env for local runtime settings if required.
# Note: Flutter client configurations (such as Firebase API keys) are not server secrets,
# but live project IDs and custom endpoints can be configured here.

# Firebase Project Configuration
FIREBASE_PROJECT_ID=skill-link-prod
FIREBASE_WEB_API_KEY=AIzaSyPlaceholderWebApiKey
FIREBASE_WEB_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_STORAGE_BUCKET=skill-link-prod.appspot.com

# Firebase Emulator Mode (Set to true to connect to local Firebase emulators)
USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost

