rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role helpers based on stored roles in user doc
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && 
        role in getUserData(request.auth.uid).roles;
    }

    function isValidRoleList(roles) {
      // Must only contain 'customer' and/or 'worker'. Admin self-assignment is strictly forbidden!
      return roles is list &&
             roles.size() >= 1 &&
             roles.size() <= 2 &&
             roles.hasOnly(['customer', 'worker']);
    }

    function isValidActiveRole(role) {
      return role in ['customer', 'worker'];
    }

    // =========================================================================
    // USERS COLLECTION: users/{uid}
    // Private user profile. Strictly owner readable and owner writable.
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        isValidRoleList(request.resource.data.roles) &&
        isValidActiveRole(request.resource.data.activeRole) &&
        request.resource.data.keys().hasAll(['uid', 'email', 'fullName', 'roles', 'activeRole', 'createdAt']) &&
        // Ensure no admin escalation
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      allow update: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        // Prevent changing email or uid
        request.resource.data.email == resource.data.email &&
        isValidRoleList(request.resource.data.roles) &&
        isValidActiveRole(request.resource.data.activeRole) &&
        // Enforce that activeRole must exist in the user's roles
        request.resource.data.activeRole in request.resource.data.roles &&
        // Ensure user cannot grant themselves admin
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      allow delete: if false; // Deletion handled via account management or Cloud Function
    }

    // =========================================================================
    // WORKER PROFILES: workerProfiles/{workerId}
    // Public directory data. Readable by any client (even public landing page).
    // Writable only by the verified worker owner.
    // =========================================================================
    match /workerProfiles/{workerId} {
      allow read: if true; // Public worker discovery

      allow create: if isOwner(workerId) &&
        request.resource.data.uid == workerId &&
        hasRole('worker') &&
        request.resource.data.keys().hasAll(['uid', 'fullName', 'headline', 'category', 'experienceYears', 'city', 'rate', 'availability']) &&
        request.resource.data.rate is number && request.resource.data.rate >= 0 &&
        request.resource.data.experienceYears is number && request.resource.data.experienceYears >= 0;

      allow update: if isOwner(workerId) &&
        request.resource.data.uid == workerId &&
        // Worker cannot manipulate rating or review count directly
        request.resource.data.averageRating == resource.data.averageRating &&
        request.resource.data.reviewCount == resource.data.reviewCount;

      allow delete: if isOwner(workerId);
    }

    // =========================================================================
    // JOBS COLLECTION: jobs/{jobId}
    // Readable by authenticated users (or workers browsing).
    // Created and managed only by the customer owner.
    // =========================================================================
    match /jobs/{jobId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        hasRole('customer') &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['open', 'in_progress', 'completed', 'cancelled'] &&
        request.resource.data.budget is number && request.resource.data.budget >= 0 &&
        request.resource.data.keys().hasAll(['customerId', 'title', 'category', 'description', 'city', 'budget', 'status', 'createdAt']);

      allow update: if isAuthenticated() &&
        resource.data.customerId == request.auth.uid &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['open', 'in_progress', 'completed', 'cancelled'];

      allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }

    // =========================================================================
    // APPLICATIONS COLLECTION: applications/{applicationId}
    // Created by workers for open jobs.
    // Readable by the worker who applied OR the customer who posted the job.
    // Customer can update status (accept/reject). Worker can withdraw.
    // =========================================================================
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.workerId == request.auth.uid ||
        resource.data.customerId == request.auth.uid
      );

      allow create: if isAuthenticated() &&
        hasRole('worker') &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'applied' &&
        request.resource.data.keys().hasAll(['jobId', 'customerId', 'workerId', 'message', 'proposedRate', 'status', 'createdAt']);

      allow update: if isAuthenticated() && (
        // Worker can withdraw their application
        (resource.data.workerId == request.auth.uid && 
         request.resource.data.status == 'withdrawn' && 
         resource.data.status == 'applied') ||
        // Customer can accept or reject applications on their jobs
        (resource.data.customerId == request.auth.uid && 
         request.resource.data.status in ['accepted', 'rejected', 'under_review'])
      );

      allow delete: if isAuthenticated() && resource.data.workerId == request.auth.uid;
    }

    // =========================================================================
    // SAVED WORKERS COLLECTION: savedWorkers/{docId}
    // Customer bookmarking workers. Strictly customer owner access.
    // =========================================================================
    match /savedWorkers/{docId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
      
      allow create: if isAuthenticated() &&
        hasRole('customer') &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.workerId != request.auth.uid;

      allow delete: if isAuthenticated() && resource.data.customerId == request.auth.uid;
    }

    // =========================================================================
    // REVIEWS COLLECTION: reviews/{reviewId}
    // Publicly readable ratings and feedback.
    // Only customer can create after a job. Cannot review oneself.
    // =========================================================================
    match /reviews/{reviewId} {
      allow read: if true; // Public reviews display

      allow create: if isAuthenticated() &&
        hasRole('customer') &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.workerId != request.auth.uid &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.keys().hasAll(['jobId', 'customerId', 'workerId', 'rating', 'comment', 'createdAt']);

      allow update, delete: if false; // Reviews are permanent audit records
    }

    // =========================================================================
    // NOTIFICATIONS COLLECTION: notifications/{notificationId}
    // Strictly recipient readable and recipient updatable (e.g. mark read).
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.recipientId == request.auth.uid;

      // System or authorized user can create a notification directed to another
      allow create: if isAuthenticated() &&
        request.resource.data.recipientId != null &&
        request.resource.data.keys().hasAll(['recipientId', 'title', 'message', 'type', 'read', 'createdAt']);

      // Recipient can mark as read
      allow update: if isAuthenticated() &&
        resource.data.recipientId == request.auth.uid &&
        request.resource.data.recipientId == request.auth.uid;

      allow delete: if isAuthenticated() && resource.data.recipientId == request.auth.uid;
    }
  }
}

